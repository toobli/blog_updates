# ShieldTX site env vars. Copy to .env.local for `vercel dev`.
# Never commit real secrets.

# Scanner v2 backend/frontend used by the public preview funnel.
SCANNER_API_BASE=https://scanner.shieldtx.xyz
SCANNER_APP_BASE=https://scanner.shieldtx.xyz

# Pepper for hashing client IPs before storage.
IP_HASH_PEPPER=

# DB connection string. Left blank in Phase 1 — lib/db.js falls back to an
# in-memory stub that logs submissions. Plug in Supabase/Neon/Vercel Postgres
# here when ready.
DATABASE_URL=

# Airtable mirror for form submissions. When TOKEN + BASE_ID are set, lib/db.js
# writes each submission as a record.
#
# Left blank: the mirror is skipped. On preview/dev that's a quiet warn; on
# VERCEL_ENV=production it emits an AIRTABLE_MIRROR_FAILED alert line, because
# an unconfigured prod deploy silently dropping leads is what this is for.
#
# Every submission logs exactly one of:
#   [airtable] AIRTABLE_MIRROR_OK      {...record_id...}
#   [airtable] AIRTABLE_MIRROR_FAILED  {...reason, error, lost_submission...}
# Alert on the FAILED token; the failure line carries the full submission so a
# lead can be recovered by hand. Also worth an alert: zero OK lines in 24h.
#
# The table's column names must match the payload keys exactly — Airtable
# rejects the whole record on one unknown field. Current keys:
#   first_name, last_name, email, trade_type, platforms, volume, pain,
#   protection, urgency, use_type, ip_hash, user_agent, created_at
# created_at must be a writable field (text/date), NOT a computed "Created time".
# TOKEN: a Personal Access Token (airtable.com/create/tokens) with the
#   data.records:write scope, granted to the base below. Never commit it.
# BASE_ID: starts with "app...", from the base's API docs/URL.
# TABLE: request-access table; defaults to "Invite Requests" if unset.
# FAILURE_TABLE: when a write to AIRTABLE_TABLE is rejected, the submission is
#   written here instead so the lead isn't lost. Defaults to "Mirror Failures".
#   Create it in the same base with exactly three columns:
#     email   — single line text
#     payload — long text
#     error   — single line text
#   Only three columns, all stable, so this keeps working when the main table's
#   schema drifts. Reuses the same token and base — no extra config needed.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Invite Requests
AIRTABLE_FAILURE_TABLE=Mirror Failures

# Google Sheets mirror for the API access form (lib/sheets.js). Server-to-server
# auth via a GCP service account — no OAuth consent flow needed.
#
# Setup (once):
#   1. GCP Console → APIs & Services → Library → enable "Google Sheets API".
#   2. IAM & Admin → Service Accounts → Create → Keys → Add JSON key.
#   3. Create a spreadsheet; share it with the service account email as Editor.
#   4. Set the three vars below in Vercel (and .env.local for local testing).
#
# The "API Access Requests" tab is created automatically on first submission.
# Every write logs one of:
#   [sheets] GOOGLE_SHEETS_APPEND_FAILED  {...reason, lost_row...}
# (success is silent except for the normal '[api-access] request stored' line).
# Alert on the FAILED token; the failure line carries the full row.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
